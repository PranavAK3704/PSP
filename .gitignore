# ── Secrets — MUST never be committed (Render provides these via env) ────────
backend/data/*.txt
backend/.env
.env
**/.env
!backend/.env.example

# ── Large / external data (loss data lives in Turso in prod) ─────────────────
# Path-anchored patterns only covered backend/data/, so a stray DB one directory up (sqlite3
# silently CREATES the file when a `cd` fails and you open a relative name) was stageable.
# These match anywhere in the tree.
*.db
*.sqlite
*.sqlite3
backend/data/*.csv

# ── Build + vendor artifacts ─────────────────────────────────────────────────
**/node_modules
**/.venv
**/__pycache__
*.pyc
**/dist
frontend/dist

# ── OS / editor cruft ────────────────────────────────────────────────────────
**/.DS_Store
*.log

# ── Runtime state (seeded on first run; on Render lives on the persistent disk) ──
backend/data/*.json
!backend/data/knowledge/*.json
!backend/data/knowledge_sources/*.json
.claude/settings.local.json
.agent-memory/

# generated deliverable docs (regeneratable — not source)
/Valmo_Advocate_*.docx
/Valmo_Advocate_*.pdf

# Kapture browse credentials + session state (never commit)
backend/data/kapture_creds.txt
backend/data/kapture_session.json
