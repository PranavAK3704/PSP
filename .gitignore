# ── Secrets — MUST never be committed (Render provides these via env) ────────
backend/data/*.txt
backend/.env
.env
**/.env
!backend/.env.example

# ── Large / external data (loss data lives in Turso in prod) ─────────────────
# Path-anchored patterns only covered backend/data/, so a stray DB one directory up (sqlite3
# silently CREATES the file when a `cd` fails and you open a relative name) was stageable.
# These match anywhere in the tree.
*.db
*.sqlite
*.sqlite3
backend/data/*.csv

# ── Build + vendor artifacts ─────────────────────────────────────────────────
**/node_modules
**/.venv
**/__pycache__
*.pyc
**/dist
frontend/dist

# ── OS / editor cruft ────────────────────────────────────────────────────────
**/.DS_Store
*.log

# ── Runtime state (seeded on first run; on Render lives on the persistent disk) ──
backend/data/*.json
!backend/data/knowledge/*.json
!backend/data/knowledge_sources/*.json
.claude/settings.local.json
.agent-memory/

# generated deliverable docs (regeneratable — not source)
/Valmo_Advocate_*.docx
/Valmo_Advocate_*.pdf

# Kapture browse credentials + session state (never commit)
backend/data/kapture_creds.txt
backend/data/kapture_session.json

# One-off safety snapshot written by scripts/classify_concern_provenance.py --apply.
# Local-only by design: the durable truth is the mirrored ledger, and a second copy that
# drifts is worse than no copy.
backend/data/concern_log.pre-provenance-*.json
# The 8 concern rows that exist only as traces in the Turso mirror (see the damage assessment
# in the review-fixes commit). Kept locally so they survive this session; git-ignored because
# they are recoverable test-captain turns, not authored content.
backend/data/concern_log.orphaned-traces-8.json

# ── COMMITTED ON PURPOSE: the ticket aggregate ────────────────────────────────────────────────
# `backend/data/*.json` above excludes the mutable stores, which is right. This one is the
# opposite: a small, generated, counts-only snapshot of the 140,875-ticket export, needed because
# tickets.db is 39 MB and .dockerignore'd — so without it the deployed Data Access page loses its
# best evidence. Regenerate with scripts/build_tickets_summary.py, which refuses to write
# anything that looks like row data rather than a count.
!backend/data/tickets_summary.json

# Live Slack pulls contain real user ids, emails and message text. The pipeline writes them
# here so validate.js can gate them exactly as it gates an export — but they are never
# committed. Synthetic fixtures under data/intake/fixtures/ are, and are safe by construction.
backend/data/intake/live/
backend/data/intake/raw/

# The derived disposition corpus carries the same partner text as its source,
# backend/data/kapture_audits.json — which .gitignore:30 already keeps out of the repo.
# Committing the derivative would leak exactly what the source rule exists to withhold.
# scripts/build_corpus_from_audits.py regenerates it in seconds, so nothing is lost.
backend/data/intake/corpus/dispositions.json
backend/data/intake/corpus/dispositions_holdout.json
backend/data/intake/corpus/exemplars.json
